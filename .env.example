# Copy to .env for Docker Compose. Development values only; never commit a real .env.
POSTGRES_USER=techscout
POSTGRES_PASSWORD=change-me
POSTGRES_DB=techscout

# Host ports published by Compose (127.0.0.1 only). Change them if already in use.
DB_PORT=5432
APP_PORT=8000

# Compose reads only POSTGRES_*, DB_PORT and APP_PORT from this file: it builds the app's
# DATABASE_URL itself, and the image sets EVIDENCE_DIR. For host use (alembic, uvicorn,
# python -m app.runs), export these in your shell; nothing reads them from .env.
# Without DATABASE_URL, a local SQLite file (techscout.db) is used for quick experiments.
# DATABASE_URL=postgresql+psycopg://techscout:change-me@localhost:5432/techscout
# EVIDENCE_DIR=./var/evidence   # raw retailer responses by SHA-256; keep outside any web-served directory

# ANTHROPIC_API_KEY is not set here. Only the model planner (`python -m app.runs search ... --planner
# model`) uses API credentials, such as ANTHROPIC_API_KEY, and they must be exported in the shell
# that runs the command: nothing reads them from .env, and Compose does not pass them to the app
# container. Never commit a real key. Searches default to the rule baseline, which needs no key;
# --planner model without credentials exits 2. Tests never call the API.
