# Copy to .env for Docker Compose. Development values only; never commit a real .env.
POSTGRES_USER=techscout
POSTGRES_PASSWORD=change-me
POSTGRES_DB=techscout

# Host ports published by Compose (127.0.0.1 only). Change them if already in use.
DB_PORT=5432
APP_PORT=8000

# Used by the app and Alembic. Compose builds this from the values above.
# Without DATABASE_URL, a local SQLite file (techscout.db) is used for quick experiments.
DATABASE_URL=postgresql+psycopg://techscout:change-me@localhost:5432/techscout

# Raw retailer responses, addressed by SHA-256. Keep outside any web-served directory.
EVIDENCE_DIR=./var/evidence
