# Copy to .env for Docker Compose. Development only. Keep the real file out of Git.
POSTGRES_USER=techscout
POSTGRES_PASSWORD=change-me
POSTGRES_DB=techscout

# Compose binds both ports to localhost. Change them if already in use.
DB_PORT=5432
APP_PORT=8000
# Local HTTP only. Set 1 behind HTTPS; standalone backend defaults to secure cookies.
TECHSCOUT_COOKIE_SECURE=0

# Optional backend credentials. Leave blank for local startup and fixture tests.
# Set these in the repository-root .env or the backend shell when integrations need them.
# Do not put provider credentials in frontend/.env or VITE_ variables.
OPENAI_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# Host-only overrides for Alembic, Uvicorn and CLI runs. Export these in your shell.
# Without DATABASE_URL, host runs default to SQLite.
# DATABASE_URL=postgresql+psycopg://techscout:change-me@localhost:5432/techscout
# EVIDENCE_DIR=./var/evidence
# ANTHROPIC_API_KEY=    # optional only for explicit historical Anthropic evaluations
