# Copy to .env for Docker Compose. Development only. Keep the real file out of Git.
POSTGRES_USER=techscout
POSTGRES_PASSWORD=change-me
POSTGRES_DB=techscout

# Compose binds both ports to localhost. Change them if already in use.
DB_PORT=5432
APP_PORT=8000
# Local HTTP only. Set 1 behind HTTPS; standalone backend defaults to secure cookies.
TECHSCOUT_COOKIE_SECURE=0

# Optional backend credentials. Leave blank for local startup and fixture tests.
# Set these in the repository-root .env or the backend shell when integrations need them.
# Do not put provider credentials in frontend/.env or VITE_ variables.
OPENAI_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
# Backend inference and embeddings. The buyer worker and catalog CLI load these from .env.
OPENROUTER_API_KEY=
# Set the verified all-inclusive USD rate per million input tokens to enable semantic retrieval.
TECHSCOUT_EMBEDDING_USD_PER_MILLION=

# Host-only overrides for Alembic, Uvicorn and CLI runs. Export these in your shell.
# Without DATABASE_URL, host runs default to SQLite.
# DATABASE_URL=postgresql+psycopg://techscout:change-me@localhost:5432/techscout
# EVIDENCE_DIR=./var/evidence
# ANTHROPIC_API_KEY=    # optional only for explicit historical Anthropic evaluations

# Accounting is a separate, explicit PostgreSQL connection; never a local SQLite fallback.
# Local Windows setup: load saved user settings with scripts/Use-LocalAccounting.ps1.
# Keep the password in a private libpq password file. Never commit its contents.
# TECHSCOUT_ACCOUNTING_URL=postgresql+psycopg://techscout_accounting@127.0.0.1:5432/techscout_accounting?connect_timeout=5
# TECHSCOUT_ACCOUNTING_PROJECT=techscout-december-2026
# Containers need their own reachable endpoint and password-file mount; host loopback is not container loopback.

# Optional domestic discovery connectors. Provide the applicable all-inclusive unit prices.
# Manual rotation and buyer research use the same backend settings (docs/discovery.md).
TAVILY_USD_PER_CREDIT=
SERPAPI_API_KEY=
SERPAPI_USD_PER_SEARCH=
BRAVE_SEARCH_API_KEY=
BRAVE_USD_PER_SEARCH=
FIRECRAWL_SEARCH_USD_PER_CREDIT=
FIRECRAWL_SCRAPE_USD_PER_CREDIT=
# JSON array of reviewed manufacturer directory pages and their domestic retailer selectors.
TECHSCOUT_MANUFACTURER_DIRECTORIES=
